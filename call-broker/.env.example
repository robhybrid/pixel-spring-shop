# Copy to ~/.config/pixel-spring/ or export in the shell. Never commit real values.

# Ring a Human (primary speed-to-lead rail)
RINGAHUMAN_API_KEY=
RINGAHUMAN_EMAIL=

# GoHireHumans (marketplace / fixed-budget phone tasks)
GOHIREHUMANS_API_KEY=
GOHIREHUMANS_AUTH_TOKEN=
GOHIREHUMANS_API_URL=https://gohirehumans-production.up.railway.app

# Ringg (manual marketplace — no public agent API yet)
RINGG_API_KEY=
RINGG_ACCOUNT_EMAIL=

# Phone.do (BPO — account required; API surface TBD)
PHONEDO_API_KEY=
PHONEDO_ACCOUNT_EMAIL=

# Limited x402 spend wallet (Coinbase CDP) — fund with a hard cap, e.g. $20 USDC
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
X402_PAY_TO=
X402_SPEND_CAP_USDC=20

# Broker defaults
CALL_BROKER_MODE=sandbox
CALL_BROKER_DEFAULT_PROVIDER=ringahuman
CALL_BROKER_MARKUP_MULTIPLIER=1.5
CALL_BROKER_WEBHOOK_BASE=
